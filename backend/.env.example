# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pfims

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=PFIMS

# Client URL
CLIENT_URL=http://localhost:3000

# Security
BCRYPT_ROUNDS=12

# AI Provider
AI_PROVIDER=atlas

# AtlasCloud Configuration
ATLASCLOUD_API_KEY=your_atlascloud_api_key_here
ATLAS_API_URL=https://api.atlascloud.ai/v1/chat/completions
ATLAS_MODEL=zai-org/GLM-4.5-Air
ATLAS_MAX_TOKENS=4096
ATLAS_TEMPERATURE=0.7
ATLAS_TOP_P=0.9
ATLAS_TOP_K=50
ATLAS_REPETITION_PENALTY=1.1

# Ollama (local) Configuration
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=meta-llama-3-8b-instruct-q4km
OLLAMA_MODEL_LITE=meta-llama-3-8b-instruct-q4km
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_BATCH=32

# Market News Intelligence
# Optional: set NEWSAPI_KEY to use NewsAPI provider. If empty, Yahoo Finance search news is used.
NEWSAPI_KEY=
# Flask FinBERT microservice URL
FINBERT_SERVICE_URL=http://127.0.0.1:5005
