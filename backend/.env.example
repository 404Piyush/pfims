# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pfims

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Email Configuration
# SMTP (fallback, optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=PFIMS
# Optional: specify explicit from address for SMTP
# EMAIL_FROM=pfims@example.com

# Mailgun (preferred for OTP and weekly/monthly reports)
# To use Mailgun, set the following and leave SMTP blank if desired.
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here
# Optional: custom Mailgun "from". If not set, uses "PFIMS <postmaster@{MAILGUN_DOMAIN}>"
# MAILGUN_FROM=PFIMS <postmaster@your_mailgun_domain_here>

# Example (sandbox):
# MAILGUN_API_KEY=ad2a8e9a9210afac7f03d893f0fa17fb-653fadca-20e97a29
# MAILGUN_DOMAIN=sandbox2a4bb74513bb481692ac1805043aa5fc.mailgun.org
# MAILGUN_FROM=Mailgun Sandbox <postmaster@sandbox2a4bb74513bb481692ac1805043aa5fc.mailgun.org>

# Client URL
CLIENT_URL=http://localhost:3000

# Security
BCRYPT_ROUNDS=12

# AI Provider
AI_PROVIDER=atlas

# AtlasCloud Configuration
ATLASCLOUD_API_KEY=your_atlascloud_api_key_here
ATLAS_API_URL=https://api.atlascloud.ai/v1/chat/completions
ATLAS_MODEL=zai-org/GLM-4.5-Air
ATLAS_MAX_TOKENS=4096
ATLAS_TEMPERATURE=0.7
ATLAS_TOP_P=0.9
ATLAS_TOP_K=50
ATLAS_REPETITION_PENALTY=1.1

# Ollama (local) Configuration
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=meta-llama-3-8b-instruct-q4km
OLLAMA_MODEL_LITE=meta-llama-3-8b-instruct-q4km
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_BATCH=32