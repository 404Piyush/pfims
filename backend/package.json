{
  "name": "pfims-backend",
  "version": "1.0.0",
  "description": "PFIMS Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'Backend build complete - Node.js project ready for production'",
    "build:prod": "npm ci --only=production && npm run build",
    "prebuild": "npm run test:database",
    "postbuild": "echo 'Backend build and validation complete'",
    "test": "jest",
    "test:auth": "node scripts/testAuth.js",
    "test:login": "node scripts/testLogin.js",
    "test:registration": "node scripts/testRegistration.js",
    "test:database": "node scripts/testDatabase.js",
    "test:email": "node scripts/testEmailService.js",
    "test:endpoints": "node scripts/testAllEndpoints.js",
    "test:all": "npm run test:database && npm run test:auth && npm run test:email && npm run test:endpoints",
    "dev:setup": "npm run test:database && echo 'Database connection verified'",
    "dev:clean": "node -e \"require('./scripts/testDatabase.js')\"",
    "dev:seed": "node scripts/seedDatabase.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.1.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-slow-down": "^2.0.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "officecrypto-tool": "^0.0.19",
    "pdfjs-dist": "^4.10.38",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "ethereal-email": "^1.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "express",
    "mongodb",
    "api",
    "finance"
  ],
  "author": "Your Name",
  "license": "MIT"
}
